# --- LEGACY (proxy path) ---
# LiteLLMClient / --mode proxy is legacy and no longer the supported flow.
# Keep these only if you still run a local LiteLLM proxy server.
LITELLM_API_KEY=your_litellm_virtual_key_here
LITELLM_BASE_URL=http://localhost:4000

# --- Supported (direct path) ---
# DirectLLMClient / --mode direct calls the provider via a litellm Router with
# built-in retry/backoff and per-retry logging. No proxy server required.
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Azure AI Foundry (shared project, API-key auth — works cross-tenant, no Entra login needed).
# Key comes from the Foundry resource owner: Portal -> resource -> Resource Management -> Keys and Endpoint.
AZURE_AI_API_KEY=your_azure_foundry_api_key_here
# Project endpoint incl. the OpenAI-compatible surface suffix (picked up via api_base_env in models.yaml):
AZURE_AI_API_BASE=https://your-resource.services.ai.azure.com/api/projects/your-project/openai/v1
# Z.AI GLM (GLM Coding Plan subscription). Get a key from
# https://z.ai/manage-apikey/apikey-list and use the Coding Plan endpoint.
ZAI_API_KEY=your_zai_api_key_here

# Local Ollama (used with --model ollama, --mode direct). No API key needed.
# Override the endpoint only if Ollama is not at the default local address.
# OLLAMA_API_BASE=http://localhost:11434
